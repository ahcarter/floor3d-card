{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://floor3d.example/schemas/thermal-flows-v1.schema.json",
  "title":"Floor3D thermal visualization artifacts v1",
  "oneOf":[{"$ref":"#/$defs/layout"},{"$ref":"#/$defs/manifest"},{"$ref":"#/$defs/dataset"}],
  "$defs":{
    "point":{"type":"object","required":["x","y","z"],"properties":{"x":{"type":"number"},"y":{"type":"number"},"z":{"type":"number"}},"additionalProperties":false},
    "layout":{"type":"object","required":["schema_version","rooms","anchors","edges"],"properties":{
      "schema_version":{"const":"thermal-flows/v1"},
      "rooms":{"type":"array","minItems":1,"items":{"type":"object","required":["id","label"],"properties":{"id":{"enum":["living_room","dining_room","kitchen","bedroom","basement"]},"label":{"type":"string","minLength":1},"object_id":{"type":"string"},"anchor_id":{"type":"string"}},"additionalProperties":false}},
      "anchors":{"type":"array","items":{"type":"object","required":["id"],"properties":{"id":{"type":"string"},"object_id":{"type":"string"},"position":{"$ref":"#/$defs/point"}},"anyOf":[{"required":["object_id"]},{"required":["position"]}],"additionalProperties":false}},
      "edges":{"type":"array","items":{"type":"object","required":["id","from","to","from_anchor","to_anchor","kind"],"properties":{"id":{"type":"string"},"from":{"type":"string"},"to":{"type":"string"},"from_anchor":{"type":"string"},"to_anchor":{"type":"string"},"kind":{"enum":["inter_room","outdoor","basement","heating","solar"]}},"additionalProperties":false}}
    },"additionalProperties":false},
    "manifest":{"type":"object","required":["schema_version","run_stamp","generated_at","layout_url","windows"],"properties":{"schema_version":{"const":"thermal-flows/v1"},"run_stamp":{"type":"string"},"generated_at":{"type":"string","format":"date-time"},"layout_url":{"type":"string"},"windows":{"type":"object","required":["2h","24h","7d"],"properties":{"2h":{"type":"string"},"24h":{"type":"string"},"7d":{"type":"string"}},"additionalProperties":false}},"additionalProperties":false},
    "roomValue":{"type":"object","required":["temperature"],"properties":{"temperature":{"type":["number","null"]},"source":{"enum":["measured","inferred","missing"]},"uncertainty":{"type":"number","minimum":0},"setpoint":{"type":"number"}},"additionalProperties":false},
    "frame":{"type":"object","required":["timestamp","rooms"],"properties":{"timestamp":{"type":"string","format":"date-time"},"rooms":{"type":"object","additionalProperties":{"$ref":"#/$defs/roomValue"}},"flows":{"type":"object","additionalProperties":{"type":"number"}},"outdoor_temperature":{"type":"number"},"basement_temperature":{"type":"number"},"hvac_state":{"type":"string"},"heating_delivery":{"type":"object","additionalProperties":{"type":"number"}},"solar_gain":{"type":"object","additionalProperties":{"type":"number"}},"summary":{"type":"object","additionalProperties":{"type":"number"}}},"additionalProperties":false},
    "dataset":{"type":"object","required":["schema_version","run_stamp","generated_at","timezone","interval_seconds","units","window","frames"],"properties":{"schema_version":{"const":"thermal-flows/v1"},"run_stamp":{"type":"string"},"generated_at":{"type":"string","format":"date-time"},"timezone":{"type":"string"},"interval_seconds":{"type":"number","exclusiveMinimum":0},"units":{"type":"object","required":["temperature","flow"],"properties":{"temperature":{"enum":["C","F"]},"flow":{"enum":["relative","W"]}},"additionalProperties":false},"window":{"enum":["2h","24h","7d"]},"layout_url":{"type":"string"},"frames":{"type":"array","items":{"$ref":"#/$defs/frame"}}},"additionalProperties":false}
  }
}
